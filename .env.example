# Copie para .env (cp .env.example .env). O .env não vai para o Git.
# Funciona como está, com o Ollama local; troque as senhas se quiser.
# Use só letras e números nas senhas (elas entram em URLs de conexão).

# Porta do NGINX, o único ponto de entrada: http://localhost:8080
APP_PORT=8080

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=troqueEstaSenha1
POSTGRES_DB=taskflow

RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=troqueEstaSenha2

# ---- Agente de IA: escolha UM provedor ----

# 1) Ollama (padrão): container local com o modelo embutido na imagem.
COMPOSE_PROFILES=ollama
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:1.7b
LLM_MODEL=

# 2) LM Studio rodando nesta máquina (ligue o servidor local no app, porta 1234):
# COMPOSE_PROFILES=
# COMPOSE_FILE=compose.yml:compose.external-llm.yml
# LLM_PROVIDER=lmstudio
# LLM_MODEL=qwen/qwen3-8b

# 3) OpenRouter (o texto sai da máquina; precisa de token):
# COMPOSE_PROFILES=
# COMPOSE_FILE=compose.yml:compose.external-llm.yml
# LLM_PROVIDER=openrouter
# LLM_MODEL=<modelo do catálogo, ex.: qwen/qwen3-8b>
# LLM_API_KEY=<seu token do OpenRouter>

LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=120000

# ---- Só para rodar a API fora do Docker (npm run dev -w api) ----
# O Compose monta as URLs sozinho a partir das variáveis acima.
# DATABASE_URL=postgres://taskflow:troqueEstaSenha1@localhost:5432/taskflow
# RABBITMQ_URL=amqp://taskflow:troqueEstaSenha2@localhost:5672
# PORT=3000
